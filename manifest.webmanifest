{
	"id": "/",
	"name": "PraiaMob",
	"short_name": "PraiaMob",
	"description": "Projeto de móveis planejados, ambientes e fabricação",
	"lang": "pt-BR",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#16191e",
	"theme_color": "#16191e",
	"icons": [
		{ "src": "/icones/praiamob-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icones/praiamob-512.png", "sizes": "512x512", "type": "image/png" }
	],
	"file_handlers": [
		{
			"action": "/",
			"accept": {
				"application/x-praiamob": [".praiamob"],
				"application/x-promob": [".promob"],
				"application/x-praiamob-projx": [".projx"]
			}
		}
	],
	"launch_handler": { "client_mode": "focus-existing" }
}
